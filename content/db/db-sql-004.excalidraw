    {
      "id": "text-21870435",
      "type": "text",
      "x": 678,
      "y": 492,
      "width": 257.05,
      "height": 85,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 197407137,
      "version": 1,
      "versionNonce": 273848032,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775805359035,
      "link": null,
      "locked": false,
      "text": "SELECT 학과, COUNT(*)\nFROM 학생\nWHERE 학년 >= 2        -- 행 필터\nGROUP BY 학과\nHAVING COUNT(*) >= 3;  -- 그룹 필터",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "SELECT 학과, COUNT(*)\nFROM 학생\nWHERE 학년 >= 2        -- 행 필터\nGROUP BY 학과\nHAVING COUNT(*) >= 3;  -- 그룹 필터",
      "lineHeight": 1.25
    }
  ],
