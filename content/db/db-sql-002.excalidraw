      "text": "NATURAL JOIN · EQUI JOIN",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 16,
      "containerId": null,
      "originalText": "NATURAL JOIN · EQUI JOIN",
      "lineHeight": 1.25
    },
    {
      "id": "text-993933230",
      "type": "text",
      "x": 80,
      "y": 544,
      "width": 551.5,
      "height": 20,
      "angle": 0,
      "strokeColor": "#444",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 1495240797,
      "version": 1,
      "versionNonce": 1116478481,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775805359035,
      "link": null,
      "locked": false,
      "text": "• NATURAL: 같은 이름 속성을 자동 조인 조건으로 사용  • EQUI: '=' 연산자로 조인",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
