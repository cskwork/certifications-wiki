      "isDeleted": false,
      "boundElements": null,
      "updated": 1775806346236,
      "link": null,
      "locked": false,
      "text": "• DNS·SNMP·DHCP = UDP 기반  |  HTTP·HTTPS·FTP·SMTP·SSH = TCP 기반",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "• DNS·SNMP·DHCP = UDP 기반  |  HTTP·HTTPS·FTP·SMTP·SSH = TCP 기반",
      "lineHeight": 1.25
    },
