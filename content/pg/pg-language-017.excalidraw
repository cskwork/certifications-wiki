      "text": "s = \"Hello World\"\ns[0:5]   → \"Hello\"\ns[6:]    → \"World\"\ns[::2]   → \"HloWrd\"\ns[::-1]  → \"dlroW olleH\"  (역순)\ns[-5:]   → \"World\"",
