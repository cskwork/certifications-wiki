      "link": null,
      "locked": false,
      "text": "s = \"apple,banana,cherry\"\na = s.split(\",\")\n  → ['apple','banana','cherry']\nb = \"-\".join(a)\n  → \"apple-banana-cherry\"\nc = b.replace(\"banana\",\"grape\")\n  → \"apple-grape-cherry\"",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
