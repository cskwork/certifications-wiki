      "seed": 1573042454,
      "version": 1,
      "versionNonce": 563672212,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775806825474,
      "link": null,
      "locked": false,
      "text": "String a = \"hello\";\nString b = \"hello\";\nString c = new String(\"hello\");\n\na == b       → true   (문자열 풀)\na == c       → false  (new로 별도 객체)\na.equals(c)  → true   (내용 비교)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "String a = \"hello\";\nString b = \"hello\";\nString c = new String(\"hello\");\n\na == b       → true   (문자열 풀)\na == c       → false  (new로 별도 객체)\na.equals(c)  → true   (내용 비교)",
      "lineHeight": 1.25
    }
