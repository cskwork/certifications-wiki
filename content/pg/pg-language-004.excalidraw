      "index": null,
      "roundness": null,
      "seed": 602366077,
      "version": 1,
      "versionNonce": 1833145559,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775806825474,
      "link": null,
      "locked": false,
      "text": "s = \"abcdefg\"\ns[2:5]    → 'cde'    (end 미포함)\ns[::2]    → 'aceg'   (step=2)\ns[::-1]   → 'gfedcba' (역순)\ns[-3:]    → 'efg'    (뒤에서 3개)\n\nlst = [10, 20, 30, 40, 50]\nlst[1:4]  → [20, 30, 40]",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "s = \"abcdefg\"\ns[2:5]    → 'cde'    (end 미포함)\ns[::2]    → 'aceg'   (step=2)\ns[::-1]   → 'gfedcba' (역순)\ns[-3:]    → 'efg'    (뒤에서 3개)\n\nlst = [10, 20, 30, 40, 50]\nlst[1:4]  → [20, 30, 40]",
      "lineHeight": 1.25
    },
