    },
    {
      "id": "text-959982079",
      "type": "text",
      "x": 674,
      "y": 452,
      "width": 290.85,
      "height": 166,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 450478119,
      "version": 1,
      "versionNonce": 565727632,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775806825474,
      "link": null,
      "locked": false,
      "text": "# 딕셔너리 컴프리헨션 (2025-2회 출제)\ndata = {'a':1,'b':2,'c':3,'d':4}\n{k:v for k,v in data.items() if v%2==0}\n→ {'b': 2, 'd': 4}\n\n# 집합 연산\na = {1,2,3,4}; b = {3,4,5,6}\na & b → {3,4}   (교집합)\na | b → {1..6}  (합집합)\na - b → {1,2}   (차집합)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "# 딕셔너리 컴프리헨션 (2025-2회 출제)\ndata = {'a':1,'b':2,'c':3,'d':4}\n{k:v for k,v in data.items() if v%2==0}\n→ {'b': 2, 'd': 4}\n\n# 집합 연산\na = {1,2,3,4}; b = {3,4,5,6}\na & b → {3,4}   (교집합)\na | b → {1..6}  (합집합)\na - b → {1,2}   (차집합)",
      "lineHeight": 1.25
    }
  ],
  "appState": {
    "viewBackgroundColor": "#ffffff",
    "gridSize": null
  },
