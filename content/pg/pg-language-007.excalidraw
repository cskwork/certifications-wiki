      "isDeleted": false,
      "boundElements": null,
      "updated": 1775806825474,
      "link": null,
      "locked": false,
      "text": "int a[] = {3,1,4,1,5};\nfor (i=0; i<4; i++)\n  for (j=0; j<4-i; j++)\n    if (a[j] > a[j+1]) swap;",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "int a[] = {3,1,4,1,5};\nfor (i=0; i<4; i++)\n  for (j=0; j<4-i; j++)\n    if (a[j] > a[j+1]) swap;",
      "lineHeight": 1.25
    },
