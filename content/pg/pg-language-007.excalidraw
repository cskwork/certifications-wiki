      "boundElements": null,
      "updated": 1775806825474,
      "link": null,
      "locked": false,
      "text": "int a[] = {10,20,30,40};\nint *p = a;          // 배열명 = 첫 원소 주소\n*(p+2) == a[2]       // 30\n\n// swap 패턴 (기출)\ntmp = a[i];\na[i] = a[j];\na[j] = tmp;",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "int a[] = {10,20,30,40};\nint *p = a;          // 배열명 = 첫 원소 주소\n*(p+2) == a[2]       // 30\n\n// swap 패턴 (기출)\ntmp = a[i];\na[i] = a[j];\na[j] = tmp;",
      "lineHeight": 1.25
