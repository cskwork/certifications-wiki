      "seed": 1170429194,
      "version": 1,
      "versionNonce": 1882110016,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775806825474,
      "link": null,
      "locked": false,
      "text": "10 → 16 변환 알고리즘 (빈출: 87→57)",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 16,
      "containerId": null,
      "originalText": "10 → 16 변환 알고리즘 (빈출: 87→57)",
      "lineHeight": 1.25
    },
    {
      "id": "text-834800086",
      "type": "text",
      "x": 674,
      "y": 176,
      "width": 278.7,
      "height": 56,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 1897043902,
      "version": 1,
      "versionNonce": 301380337,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775806825474,
      "link": null,
      "locked": false,
      "text": "87 ÷ 16 = 5 ... 7    → hex[0]='7'\n 5 ÷ 16 = 0 ... 5    → hex[1]='5'\n역순 출력 → \"57\"",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "87 ÷ 16 = 5 ... 7    → hex[0]='7'\n 5 ÷ 16 = 0 ... 5    → hex[1]='5'\n역순 출력 → \"57\"",
      "lineHeight": 1.25
    },
    {
      "id": "text-1106692816",
      "type": "text",
      "x": 674,
      "y": 270,
      "width": 283.70000000000005,
      "height": 117,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 165620450,
      "version": 1,
      "versionNonce": 636995161,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775806825474,
      "link": null,
      "locked": false,
      "text": "while (n > 0) {\n    int r = n % 16;\n    if (r < 10) hex[i] = r + '0';\n    else        hex[i] = r - 10 + 'A';\n    n = n / 16;\n    i++;\n}",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "while (n > 0) {\n    int r = n % 16;\n    if (r < 10) hex[i] = r + '0';\n    else        hex[i] = r - 10 + 'A';\n    n = n / 16;\n    i++;\n}",
      "lineHeight": 1.25
    },
