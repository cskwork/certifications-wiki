      "text": "factorial(n) 정의",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 16,
      "containerId": null,
      "originalText": "factorial(n) 정의",
      "lineHeight": 1.25
    },
    {
      "id": "text-1328226534",
      "type": "text",
      "x": 74,
      "y": 174,
      "width": 315.80000000000007,
      "height": 74,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 1339120614,
      "version": 1,
      "versionNonce": 1660410195,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775806825474,
      "link": null,
      "locked": false,
      "text": "int factorial(int n) {\n    if (n <= 1) return 1;   // 종료 조건\n    return n * factorial(n-1); // 재귀식\n}",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "int factorial(int n) {\n    if (n <= 1) return 1;   // 종료 조건\n    return n * factorial(n-1); // 재귀식\n}",
      "lineHeight": 1.25
    },
