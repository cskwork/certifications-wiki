      "roundness": null,
      "seed": 708188317,
      "version": 1,
      "versionNonce": 772823040,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775806825474,
      "link": null,
      "locked": false,
      "text": "int f(int n) {\n    if (n < 2) return n;\n    return f(n-1) + f(n-2);\n}\nf(6) = 8  (0,1,1,2,3,5,8)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "int f(int n) {\n    if (n < 2) return n;\n    return f(n-1) + f(n-2);\n}\nf(6) = 8  (0,1,1,2,3,5,8)",
      "lineHeight": 1.25
    },
