      "boundElements": null,
      "updated": 1775806825474,
      "link": null,
      "locked": false,
      "text": "typedef struct Node {\n    int data;\n    struct Node *next;\n} Node;\n\nNode *p = head;\nwhile (p != NULL) {\n    printf(\"%d \", p->data);\n    p = p->next;\n}",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "typedef struct Node {\n    int data;\n    struct Node *next;\n} Node;\n\nNode *p = head;\nwhile (p != NULL) {\n    printf(\"%d \", p->data);\n    p = p->next;\n}",
