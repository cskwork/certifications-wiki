      "boundElements": null,
      "updated": 1775806825474,
      "link": null,
      "locked": false,
      "text": "static void f(int n) {\n    if (n <= 0) return;\n    System.out.print(n % 10);\n    f(n / 10);\n}\nf(1234);",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "static void f(int n) {\n    if (n <= 0) return;\n    System.out.print(n % 10);\n    f(n / 10);\n}\nf(1234);",
      "lineHeight": 1.25
    },
