    },
    {
      "id": "text-493206357",
      "type": "text",
      "x": 674,
      "y": 472,
      "width": 277.8,
      "height": 229,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 703018241,
      "version": 1,
      "versionNonce": 1322816011,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775806825474,
      "link": null,
      "locked": false,
      "text": "class A {\n    int f(int n) {\n        if (n<=1) return 1;\n        return n * f(n-1); // 곱\n    }\n}\nclass B extends A {\n    @Override\n    int f(int n) {\n        if (n<=1) return 1;\n        return n + f(n-1); // 합 (재정의)\n    }\n}\nA o = new B();\no.f(4); // 동적 바인딩 → 4+3+2+1 = 10",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "class A {\n    int f(int n) {\n        if (n<=1) return 1;\n        return n * f(n-1); // 곱\n    }\n}\nclass B extends A {\n    @Override\n    int f(int n) {\n        if (n<=1) return 1;\n        return n + f(n-1); // 합 (재정의)\n    }\n}\nA o = new B();\no.f(4); // 동적 바인딩 → 4+3+2+1 = 10",
      "lineHeight": 1.25
    }
  ],
