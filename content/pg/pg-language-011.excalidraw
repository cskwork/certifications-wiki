    {
      "id": "text-429129212",
      "type": "text",
      "x": 80,
      "y": 617,
      "width": 538.5,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 98724656,
      "version": 1,
      "versionNonce": 1463664140,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775806825474,
      "link": null,
      "locked": false,
      "text": "• throw = 예외 발생시킴 (명령문)   • throws = 메서드 선언부에 발생 예외 명시",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "• throw = 예외 발생시킴 (명령문)   • throws = 메서드 선언부에 발생 예외 명시",
      "lineHeight": 1.25
    },
    {
      "id": "text-2107208881",
      "type": "text",
      "x": 80,
      "y": 639,
      "width": 694.5,
      "height": 20,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 932611196,
      "version": 1,
      "versionNonce": 596803340,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775806825474,
      "link": null,
      "locked": false,
      "text": "• finally에 return이 있으면 try/catch의 return을 덮어씀   • finally는 예외 여부 무관하게 항상 실행",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "• finally에 return이 있으면 try/catch의 return을 덮어씀   • finally는 예외 여부 무관하게 항상 실행",
      "lineHeight": 1.25
    }
  ],
