    {
      "id": "text-2045019097",
      "type": "text",
      "x": 80,
      "y": 626,
      "width": 548.9,
      "height": 21,
      "angle": 0,
      "strokeColor": "#1864ab",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
